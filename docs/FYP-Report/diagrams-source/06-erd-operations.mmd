  attendance_sheets {
    bigint id PK
    bigint allocation_id FK
    date date
    boolean is_locked
    bigint marked_by FK
    datetime created_at
  }
  attendance_records {
    bigint id PK
    bigint attendance_sheet_id FK
    bigint student_id FK
    enum status "present|absent|leave"
  }
  assessments {
    bigint id PK
    bigint allocation_id FK
    enum type "quiz|assignment|mid|final|practical"
    string title
    decimal max_marks
    boolean is_published
  }
  assessment_marks {
    bigint id PK
    bigint assessment_id FK
    bigint student_id FK
    decimal obtained
  }
  classworks {
    bigint id PK
    bigint allocation_id FK
    enum type "assignment|quiz|material"
    string title
    text description
    datetime due_at
    boolean is_published
    json questions
  }
  classwork_submissions {
    bigint id PK
    bigint classwork_id FK
    bigint student_id FK
    string file_path
    json answers
    decimal score
    datetime submitted_at
  }
  book_categories {
    int id PK
    string name UK
  }
  books {
    int id PK
    int category_id FK
    string title
    string author
    string isbn
    int total_copies
    int available_copies
    string shelf
  }
  book_requests {
    bigint id PK
    int book_id FK
    bigint student_id FK
    enum status "pending|approved|rejected|issued|cancelled"
    datetime requested_at
  }
  book_issues {
    bigint id PK
    int book_id FK
    bigint student_id FK
    date issued_on
    date due_date
    date returned_on
    decimal fine_per_day
    decimal fine_amount
    enum fine_status "none|pending|paid|waived"
  }
  blocks {
    int id PK
    string name UK
    string description
  }
  rooms {
    int id PK
    int block_id FK
    string name
    enum type "classroom|lab|hall"
    int capacity
  }
  time_slots {
    int id PK
    string name
    string start_time
    string end_time
    enum shift
  }
  timetable_entries {
    bigint id PK
    bigint allocation_id FK
    int class_section_id FK
    bigint teacher_id FK
    int room_id FK
    int time_slot_id FK
    enum day "mon|tue|wed|thu|fri|sat"
  }
