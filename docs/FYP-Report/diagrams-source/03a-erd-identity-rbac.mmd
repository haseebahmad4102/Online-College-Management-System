  users {
    bigint id PK
    string name
    string email UK
    string phone
    string cnic UK
    string password
    string avatar_path
    boolean must_change_password
    boolean is_active
    datetime created_at
    datetime updated_at
  }
  roles {
    int id PK
    string name UK "admin|principal|clerk|teacher|student|librarian|timetable|hod|applicant"
  }
  permissions {
    int id PK
    string name UK "module.action"
    string group
    string label
  }
  user_roles {
    bigint user_id PK_FK
    int role_id PK_FK
  }
  role_has_permissions {
    int role_id PK_FK
    int permission_id PK_FK
  }
  user_has_permissions {
    bigint user_id PK_FK
    int permission_id PK_FK
  }
