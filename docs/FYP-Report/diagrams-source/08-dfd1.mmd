graph TB
  classDef ext fill:#dff0d8,stroke:#3c763d,stroke-width:2px
  classDef proc fill:#eef3fb,stroke:#31708f,stroke-width:2px
  classDef store fill:#fdf2e3,stroke:#b7791f

  APP([Applicant]):::ext
  STU([Student]):::ext
  TEA([Teacher]):::ext
  CLK([Clerk]):::ext
  LIB([Librarian]):::ext
  TTB([Timetable In-charge]):::ext
  MGT([Principal/Admin]):::ext

  P1[1.0<br/>Manage Identity<br/>and Access]:::proc
  P2[2.0<br/>Process<br/>Admissions]:::proc
  P3[3.0<br/>Generate<br/>Merit Lists]:::proc
  P4[4.0<br/>Manage Fees<br/>and Enrolment]:::proc
  P5[5.0<br/>Manage Academic<br/>Operations]:::proc
  P6[6.0<br/>Manage Student<br/>Lifecycle]:::proc
  P7[7.0<br/>Manage Library<br/>Circulation]:::proc

  D1[(D1 users / roles / permissions)]:::store
  D2[(D2 applications / documents)]:::store
  D3[(D3 merit_lists / entries)]:::store
  D4[(D4 challans / challan_items)]:::store
  D5[(D5 students / class_sections)]:::store
  D6[(D6 attendance / assessments / classwork)]:::store
  D7[(D7 books / requests / issues)]:::store
  D8[(D8 audit_logs)]:::store
  D9[(D9 allocations / timetable_entries)]:::store

  APP -->|credentials| P1
  STU --> P1
  TEA --> P1
  CLK --> P1
  MGT -->|role and permission changes| P1
  P1 <--> D1
  P1 -->|JWT session| APP

  APP -->|application form + documents| P2
  P2 <--> D2
  P2 -->|eligibility result| APP
  CLK -->|verify / reject document| P2
  P2 -->|verified applications| P3

  CLK -->|generate list| P3
  P3 <--> D3
  P3 -->|reads verified pool| D2
  P3 -->|merit position| APP

  P3 -->|selected candidates| P4
  P4 <--> D4
  CLK -->|verify paid challan| P4
  P4 -->|enrolment + roll number| D5
  P4 -->|fee status| STU
  P4 -->|challan| APP

  TEA -->|attendance, marks, classwork| P5
  P5 <--> D6
  P5 <--> D9
  TTB -->|timetable entries| P5
  P5 -->|conflict warning| TTB
  STU -->|submissions, quiz answers| P5
  P5 -->|attendance %, marks, timetable| STU

  CLK -->|assign shift, promote batch, set status| P6
  P6 <--> D5
  P6 -->|carry papers| D5
  P6 -->|promotion notice| STU

  STU -->|book request| P7
  LIB -->|approve, issue, return| P7
  P7 <--> D7
  P7 -->|fine amount| STU

  P1 -.-> D8
  P2 -.-> D8
  P3 -.-> D8
  P4 -.-> D8
  P5 -.-> D8
  P6 -.-> D8
  P7 -.-> D8
  D8 -->|audit trail| MGT
