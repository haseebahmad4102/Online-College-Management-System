graph TB
  classDef ext fill:#dff0d8,stroke:#3c763d,stroke-width:2px
  classDef proc fill:#eef3fb,stroke:#31708f,stroke-width:2px
  classDef store fill:#fdf2e3,stroke:#b7791f

  APP([Applicant]):::ext
  CLK([Clerk]):::ext
  MGT([Principal/Admin]):::ext

  P1[1.0<br/>Manage Identity<br/>and Access]:::proc
  P2[2.0<br/>Process<br/>Admissions]:::proc
  P3[3.0<br/>Generate<br/>Merit Lists]:::proc
  P4[4.0<br/>Manage Fees<br/>and Enrolment]:::proc

  D1[(D1 users / roles / permissions)]:::store
  D2[(D2 applications / documents)]:::store
  D3[(D3 merit_lists / entries)]:::store
  D4[(D4 challans / challan_items)]:::store
  D5[(D5 students / class_sections)]:::store
  D8[(D8 audit_logs)]:::store

  APP -->|credentials| P1
  MGT -->|role and permission changes| P1
  P1 <--> D1
  P1 -->|JWT session| APP

  APP -->|application form + documents| P2
  P2 <--> D2
  P2 -->|eligibility result| APP
  CLK -->|verify / reject document| P2
  P2 -->|verified applications| P3

  CLK -->|generate list| P3
  P3 <--> D3
  P3 -->|reads verified pool| D2
  P3 -->|merit position| APP

  P3 -->|selected candidates| P4
  P4 <--> D4
  CLK -->|verify paid challan| P4
  P4 -->|enrolment + roll number| D5
  P4 -->|challan| APP

  P1 -.-> D8
  P2 -.-> D8
  P3 -.-> D8
  P4 -.-> D8
  D8 -->|audit trail| MGT
